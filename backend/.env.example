SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> service_role / secret key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# https://console.groq.com/keys
GROQ_API_KEY=
# Models must support strict JSON-schema output on Groq; the vision model must accept images.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_GRADING_MODEL=openai/gpt-oss-120b
GROQ_CHECK_MODEL=openai/gpt-oss-120b
MAX_PARALLEL_CALLS=4

# Page reading: auto (Azure when configured, else Groq vision), azure, or groq.
OCR_PROVIDER=auto
# Azure portal -> Document Intelligence resource -> Keys and Endpoint.
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
